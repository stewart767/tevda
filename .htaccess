<IfModule mod_rewrite.c>
    Options -Indexes
    DirectoryIndex index.php public/index.php index.html

    RewriteEngine On

    # Block access to hidden files and sensitive configuration
    <FilesMatch "^\.env|\.(lock|json|xml|yml|yaml|md|cache|git|log)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Block direct access to sensitive system folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Redirect direct requests to /public or /public/* to clean root URL
    RewriteCond %{THE_REQUEST} \s/+(?:.*/)?public(?:/([^\s?]*))? [NC]
    RewriteRule ^ /%1 [L,NE,R=301]

    # If requested file exists in public directory, rewrite to it
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/tevda/public/$1 -f [OR]
    RewriteCond public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all application routes to root index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

